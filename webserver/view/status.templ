package view

import (
	"fmt"
	"github.com/coreycole/go_webserver/webserver/view/layout"
)

templ StatusPage(args layout.RootArgs) {
	@layout.Root(args) {
		<section class="py-12 md:py-20">
			<div
				class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8"
				data-init="@get('/status/events')"
				data-signals="{memTotal:'',memUsed:'',memUsedPercent:'',cpuPercent:'',uptime:'',diskTotal:'',diskUsed:'',diskUsedPercent:'',graphRange:'1h',hoveredLine:'',tooltipX:0,tooltipY:0,graphPoints:[],hoverYIdx:1,hoverVIdx:5,dotLeft:-10,dotTop:-10,tooltipText:'',hoverActive:false,showCPU:true,showMem:true,showViews:true}"
			>
				<h1 class="text-2xl font-bold text-foreground mb-8">Server Status</h1>
				<script>
				function findNearestPoint(pts, xPct) {
					if (!pts || !pts.length) return null;
					var best = 0, bestD = Math.abs(xPct - pts[0][0]);
					for (var i = 1; i < pts.length; i++) {
						var d = Math.abs(xPct - pts[i][0]);
						if (d < bestD) { bestD = d; best = i; }
					}
					return pts[best];
				}
				</script>
				<!-- Metrics Graph -->
				<div class="mb-8">
					<div class="flex items-center justify-between mb-2">
						<h2 class="text-lg font-semibold text-foreground">Metrics</h2>
						<div class="flex gap-1">
							@graphRangeButton("1h", "1h")
							@graphRangeButton("6h", "6h")
							@graphRangeButton("24h", "24h")
							@graphRangeButton("3d", "3d")
						</div>
					</div>
					<div id="metrics-graph">
						@MetricsGraph(GraphData{})
					</div>
				</div>
				<!-- Traffic -->
				<div class="mb-8">
					<h2 class="text-lg font-semibold text-foreground mb-4">Traffic</h2>
					<div id="stats-overview">
						@StatsOverview(0, 0)
					</div>
				</div>
				<!-- System Metrics -->
				<div class="mb-8">
					<h2 class="text-lg font-semibold text-foreground mb-4">System</h2>
					<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
						@statusMetricCard("CPU", "$cpuPercent")
						@statusMetricCard("Memory Used", "$memUsed")
						@statusMetricCard("Memory %", "$memUsedPercent")
						@statusMetricCard("Total Memory", "$memTotal")
						@statusMetricCard("Uptime", "$uptime")
						@statusMetricCard("Disk Used", "$diskUsed")
						@statusMetricCard("Disk %", "$diskUsedPercent")
						@statusMetricCard("Total Disk", "$diskTotal")
					</div>
				</div>
			</div>
		</section>
	}
}

templ graphRangeButton(value string, label string) {
	<button
		class="px-2 py-1 text-xs rounded border border-border transition-colors hover:bg-accent hover:text-accent-foreground"
		data-class={ fmt.Sprintf("{'bg-accent text-accent-foreground font-medium': $graphRange === '%s'}", value) }
		data-on:click={ fmt.Sprintf("$graphRange = '%s'; @post('/status/graph')", value) }
	>
		{ label }
	</button>
}

templ statusMetricCard(label string, signalExpr string) {
	<div class="rounded-lg border border-border bg-card p-4">
		<p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">{ label }</p>
		<p class="mt-1 text-xl font-semibold text-foreground">
			<span data-text={ signalExpr } class="tabular-nums">--</span>
		</p>
	</div>
}

templ StatsOverview(totalVisits int64, uniqueVisitors int64) {
	<div class="grid grid-cols-2 gap-4">
		<div class="rounded-lg border border-border bg-card p-4">
			<p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Total Page Views</p>
			<p class="mt-1 text-xl font-semibold text-foreground tabular-nums">
				{ fmt.Sprintf("%d", totalVisits) }
			</p>
		</div>
		<div class="rounded-lg border border-border bg-card p-4">
			<p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Unique Visitors</p>
			<p class="mt-1 text-xl font-semibold text-foreground tabular-nums">
				{ fmt.Sprintf("%d", uniqueVisitors) }
			</p>
		</div>
	</div>
}

templ MetricsGraph(data GraphData) {
	<div class="rounded-lg border border-border bg-card p-4 pb-8">
		if data.TimeLabel != "" {
			<div class="mb-4">
				<span class="text-sm text-muted-foreground">{ data.TimeLabel }</span>
			</div>
		}
		if data.PointCount == 0 {
			<div class="flex items-center justify-center h-48 text-sm text-muted-foreground">
				Collecting data...
			</div>
		} else {
			<div style="display:none" data-signals={ fmt.Sprintf("{graphPoints:%s}", data.PointsJSON) }></div>
			<!-- Legend (click to toggle line visibility, hover for tooltip) -->
			<div class="flex flex-wrap gap-x-6 gap-y-1 mb-3 text-sm">
				<div
					style="anchor-name: --legend-cpu; cursor: pointer;"
					class="flex items-center gap-2 select-none transition-opacity"
					data-class="{'opacity-40': !$showCPU}"
					data-on:click="$showCPU = !$showCPU"
					data-on:mouseenter="document.getElementById('legend-cpu-tip').showPopover()"
					data-on:mouseleave="document.getElementById('legend-cpu-tip').hidePopover()"
				>
					<span class="inline-block h-0.5 w-4 bg-primary"></span>
					<span class="text-muted-foreground">CPU</span>
					<span class="font-medium text-foreground tabular-nums">{ data.CPULast }</span>
				</div>
				<div
					style="anchor-name: --legend-mem; cursor: pointer;"
					class="flex items-center gap-2 select-none transition-opacity"
					data-class="{'opacity-40': !$showMem}"
					data-on:click="$showMem = !$showMem"
					data-on:mouseenter="document.getElementById('legend-mem-tip').showPopover()"
					data-on:mouseleave="document.getElementById('legend-mem-tip').hidePopover()"
				>
					<span class="inline-block h-0.5 w-4 bg-green-500"></span>
					<span class="text-muted-foreground">Memory</span>
					<span class="font-medium text-foreground tabular-nums">{ data.MemLast }</span>
					if data.MemBytesLast != "" {
						<span class="text-xs text-muted-foreground">({ data.MemBytesLast })</span>
					}
				</div>
				<div
					style="anchor-name: --legend-views; cursor: pointer;"
					class="flex items-center gap-2 select-none transition-opacity"
					data-class="{'opacity-40': !$showViews}"
					data-on:click="$showViews = !$showViews"
					data-on:mouseenter="document.getElementById('legend-views-tip').showPopover()"
					data-on:mouseleave="document.getElementById('legend-views-tip').hidePopover()"
				>
					<span class="inline-block h-0.5 w-4 bg-orange-500"></span>
					<span class="text-muted-foreground">Views</span>
					<span class="font-medium text-foreground tabular-nums">{ data.ViewsLast }</span>
				</div>
			</div>
			<!-- Legend tooltips (anchor-positioned popovers) -->
			<div
				id="legend-cpu-tip"
				popover="manual"
				class="rounded-md border border-border bg-popover px-3 py-1.5 text-sm text-popover-foreground shadow-md pointer-events-none"
				style="position: absolute; position-anchor: --legend-cpu; top: anchor(top); left: anchor(center); translate: -50% calc(-100% - 4px); z-index: 50;"
			>
				<div class="flex items-center gap-1.5">
					<svg data-show="$showCPU" style="display:none" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
					<svg data-show="!$showCPU" style="display:none" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path><line x1="2" x2="22" y1="2" y2="22"></line></svg>
					<span data-text="$showCPU ? 'Hide' : 'Show'"></span>
				</div>
			</div>
			<div
				id="legend-mem-tip"
				popover="manual"
				class="rounded-md border border-border bg-popover px-3 py-1.5 text-sm text-popover-foreground shadow-md pointer-events-none"
				style="position: absolute; position-anchor: --legend-mem; top: anchor(top); left: anchor(center); translate: -50% calc(-100% - 4px); z-index: 50;"
			>
				<div class="flex items-center gap-1.5">
					<svg data-show="$showMem" style="display:none" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
					<svg data-show="!$showMem" style="display:none" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path><line x1="2" x2="22" y1="2" y2="22"></line></svg>
					<span data-text="$showMem ? 'Hide' : 'Show'"></span>
				</div>
			</div>
			<div
				id="legend-views-tip"
				popover="manual"
				class="rounded-md border border-border bg-popover px-3 py-1.5 text-sm text-popover-foreground shadow-md pointer-events-none"
				style="position: absolute; position-anchor: --legend-views; top: anchor(top); left: anchor(center); translate: -50% calc(-100% - 4px); z-index: 50;"
			>
				<div class="flex items-center gap-1.5">
					<svg data-show="$showViews" style="display:none" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
					<svg data-show="!$showViews" style="display:none" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path><line x1="2" x2="22" y1="2" y2="22"></line></svg>
					<span data-text="$showViews ? 'Hide' : 'Show'"></span>
				</div>
			</div>
			<!-- Hover tooltip (fixed position, follows mouse) -->
			<div
				style="display: none; position: fixed; z-index: 50; pointer-events: none;"
				data-show="$hoverActive"
				data-style:left="$tooltipX + 'px'"
				data-style:top="($tooltipY - 50) + 'px'"
			>
				<div style="transform: translateX(-50%); white-space: nowrap;" class="rounded-md border border-border bg-popover px-3 py-1.5 text-sm text-popover-foreground shadow-md">
					<span data-text="$tooltipText"></span>
				</div>
			</div>
			<!-- Chart -->
			<div class="relative h-48">
				<!-- Left Y-axis labels (0-100% scale for CPU/Memory) -->
				<div class="absolute left-0 top-0 bottom-0 w-8 flex flex-col justify-between text-[10px] text-muted-foreground tabular-nums pointer-events-none">
					<span>100%</span>
					<span>75%</span>
					<span>50%</span>
					<span>25%</span>
					<span>0%</span>
				</div>
				<!-- Right Y-axis labels (auto-scaled for Views) -->
				<div class="absolute right-0 top-0 bottom-0 w-10 flex flex-col justify-between text-[10px] text-orange-500 tabular-nums pointer-events-none text-right">
					<span>{ data.ViewsAxisMax }</span>
					<span></span>
					<span>{ data.ViewsAxisMid }</span>
					<span></span>
					<span>{ data.ViewsAxisMin }</span>
				</div>
				<!-- SVG chart area -->
				<div class="mx-10 h-full relative overflow-hidden">
					<svg viewBox="0 0 100 100" preserveAspectRatio="none" class="w-full h-full">
						<!-- Grid lines at 25%, 50%, 75% -->
						<line x1="0" y1="25" x2="100" y2="25" stroke="currentColor" class="text-border" stroke-width="0.5" vector-effect="non-scaling-stroke"></line>
						<line x1="0" y1="50" x2="100" y2="50" stroke="currentColor" class="text-border" stroke-width="0.5" vector-effect="non-scaling-stroke"></line>
						<line x1="0" y1="75" x2="100" y2="75" stroke="currentColor" class="text-border" stroke-width="0.5" vector-effect="non-scaling-stroke"></line>
						<!-- CPU -->
						<g data-show="$showCPU">
							<path
								d={ data.CPUPath }
								fill="none"
								stroke="transparent"
								stroke-width="12"
								vector-effect="non-scaling-stroke"
								pointer-events="stroke"
								style="cursor: pointer;"
								data-on:mouseenter="$hoveredLine = 'CPU'; $hoverYIdx = 1; $hoverVIdx = 5"
								data-on:mouseleave="$hoveredLine = ''; $hoverActive = false; $tooltipText = ''"
								data-on:mousemove__throttle.16ms="var svg = evt.currentTarget.closest('svg'); var rect = svg.getBoundingClientRect(); var xPct = (evt.clientX - rect.left) / rect.width * 100; var pt = findNearestPoint($graphPoints, xPct); $tooltipX = evt.clientX; $tooltipY = evt.clientY; $hoverActive = true; if (pt) { $dotLeft = pt[0]; $dotTop = pt[$hoverYIdx]; $tooltipText = $hoveredLine + ': ' + pt[$hoverVIdx] + ' at ' + pt[4]; }"
							></path>
							<path
								d={ data.CPUPath }
								fill="none"
								stroke="hsl(var(--primary))"
								stroke-width="2"
								vector-effect="non-scaling-stroke"
								pointer-events="none"
							></path>
						</g>
						<!-- Memory -->
						<g data-show="$showMem">
							<path
								d={ data.MemPath }
								fill="none"
								stroke="transparent"
								stroke-width="12"
								vector-effect="non-scaling-stroke"
								pointer-events="stroke"
								style="cursor: pointer;"
								data-on:mouseenter="$hoveredLine = 'Memory'; $hoverYIdx = 2; $hoverVIdx = 6"
								data-on:mouseleave="$hoveredLine = ''; $hoverActive = false; $tooltipText = ''"
								data-on:mousemove__throttle.16ms="var svg = evt.currentTarget.closest('svg'); var rect = svg.getBoundingClientRect(); var xPct = (evt.clientX - rect.left) / rect.width * 100; var pt = findNearestPoint($graphPoints, xPct); $tooltipX = evt.clientX; $tooltipY = evt.clientY; $hoverActive = true; if (pt) { $dotLeft = pt[0]; $dotTop = pt[$hoverYIdx]; $tooltipText = $hoveredLine + ': ' + pt[$hoverVIdx] + ' at ' + pt[4]; }"
							></path>
							<path
								d={ data.MemPath }
								fill="none"
								stroke="#22c55e"
								stroke-width="2"
								vector-effect="non-scaling-stroke"
								pointer-events="none"
							></path>
						</g>
						<!-- Views -->
						<g data-show="$showViews">
							<path
								d={ data.ViewsPath }
								fill="none"
								stroke="transparent"
								stroke-width="12"
								vector-effect="non-scaling-stroke"
								pointer-events="stroke"
								style="cursor: pointer;"
								data-on:mouseenter="$hoveredLine = 'Views'; $hoverYIdx = 3; $hoverVIdx = 7"
								data-on:mouseleave="$hoveredLine = ''; $hoverActive = false; $tooltipText = ''"
								data-on:mousemove__throttle.16ms="var svg = evt.currentTarget.closest('svg'); var rect = svg.getBoundingClientRect(); var xPct = (evt.clientX - rect.left) / rect.width * 100; var pt = findNearestPoint($graphPoints, xPct); $tooltipX = evt.clientX; $tooltipY = evt.clientY; $hoverActive = true; if (pt) { $dotLeft = pt[0]; $dotTop = pt[$hoverYIdx]; $tooltipText = $hoveredLine + ': ' + pt[$hoverVIdx] + ' at ' + pt[4]; }"
							></path>
							<path
								d={ data.ViewsPath }
								fill="none"
								stroke="#f97316"
								stroke-width="2"
								vector-effect="non-scaling-stroke"
								pointer-events="none"
							></path>
						</g>
					</svg>
					<!-- Hover dot -->
					<div
						style="display: none; position: absolute; width: 10px; height: 10px; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none;"
						data-show="$hoverActive"
						data-style:left="$dotLeft + '%'"
						data-style:top="$dotTop + '%'"
						data-class="{'bg-primary': $hoveredLine === 'CPU', 'bg-green-500': $hoveredLine === 'Memory', 'bg-orange-500': $hoveredLine === 'Views'}"
					>
						<div style="position: absolute; inset: -2px; border-radius: 50%; border: 2px solid hsl(var(--background));"></div>
					</div>
				</div>
				<!-- Time axis -->
				<div class="mx-10 flex justify-between text-[10px] text-muted-foreground mt-2 pb-2">
					<span>{ data.TimeStart }</span>
					<span>{ data.TimeEnd }</span>
				</div>
			</div>
		}
	</div>
}
