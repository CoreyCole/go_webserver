package layout

templ Footer() {
	<footer class="border-t border-border/40 py-6 mt-auto">
		<div class="mx-auto max-w-5xl px-4 flex items-center justify-between text-sm text-muted-foreground">
			<span>&copy; 2026 Corey Cole · <a href="https://github.com/CoreyCole/go_webserver" target="_blank" rel="noreferrer" class="text-primary hover:underline">Built</a> with Go, Templ, <a href="https://data-star.dev/" target="_blank" rel="noreferrer" class="text-primary hover:underline">Datastar</a> and <a href="https://datastar-ui.com/" target="_blank" rel="noreferrer" class="text-primary hover:underline">DatastarUI</a></span>
			<nav class="flex items-center gap-4">
				<a href="https://github.com/coreycole" target="_blank" rel="noreferrer" class="hover:text-foreground transition-colors">GitHub</a>
				<a href="https://x.com/ccoreycole" target="_blank" rel="noreferrer" class="hover:text-foreground transition-colors">X</a>
				<a href="https://linkedin.com/in/coreylcole" target="_blank" rel="noreferrer" class="hover:text-foreground transition-colors">LinkedIn</a>
			</nav>
		</div>
	</footer>
}
